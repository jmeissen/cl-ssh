(defpackage #:ssh/tests/sftp
  (:use #:cl #:parachute #:trivial-gray-streams #:ssh/sftp #:ssh/sftp/codec)
  (:import-from #:ssh/tests #:octets))
(in-package #:ssh/tests/sftp)

;; In-memory full-duplex server: callbacks execute on the sending test thread.
(defclass mock-sftp-stream (fundamental-binary-input-stream fundamental-binary-output-stream)
  ((input :initform (ssh/channel-buffer:make-input-buffer) :reader mock-input)
   (lock :initform (bt2:make-lock) :reader mock-lock)
   (condition :initform (bt2:make-condition-variable) :reader mock-condition)
   (done :initform nil :accessor mock-done)
   (callback :initarg :callback :reader mock-callback)
   (version-payload :initarg :version-payload :initform (octets 0 0 0 3) :reader mock-version-payload)
   (sent :initform nil :accessor mock-sent)))

(defun feed-mock (stream frame)
  (bt2:with-lock-held ((mock-lock stream))
    (ssh/channel-buffer:buffer-accept (mock-input stream) frame)
    (bt2:condition-broadcast (mock-condition stream))))

(defmethod stream-read-sequence ((stream mock-sftp-stream) sequence start end &key &allow-other-keys)
  (bt2:with-lock-held ((mock-lock stream))
    (loop while (and (= 0 (ssh/channel-buffer:input-buffer-count (mock-input stream)))
                     (not (mock-done stream)))
          do (bt2:condition-wait (mock-condition stream) (mock-lock stream)))
    (+ start (ssh/channel-buffer:buffer-take (mock-input stream) sequence start end))))

(defmethod stream-write-sequence ((stream mock-sftp-stream) sequence start end &key &allow-other-keys)
  (let* ((frame (subseq sequence start end))
         (buffer (ssh/buffer:make-read-buffer frame)))
    (push frame (mock-sent stream))
    (let ((length (ssh/buffer:read-uint32 buffer)) (type (ssh/buffer:read-byte* buffer)))
      (unless (= length (- (length frame) 4)) (error "Bad test request frame"))
      (if (= type 1)
          (feed-mock stream (encode-frame 2 (mock-version-payload stream)))
          (funcall (mock-callback stream) stream type buffer))))
  sequence)

(defmethod close ((stream mock-sftp-stream) &key abort)
  (declare (ignore abort))
  (bt2:with-lock-held ((mock-lock stream))
    (setf (mock-done stream) t)
    (bt2:condition-broadcast (mock-condition stream)))
  (call-next-method))

(defun reply (stream type id writer)
  (let ((buffer (ssh/buffer:make-write-buffer)))
    (ssh/buffer:write-uint32 buffer id)
    (funcall writer buffer)
    (feed-mock stream (encode-frame type (ssh/buffer:buffer-to-octets buffer)))))

(defun status-reply (stream id code)
  (reply stream 101 id (lambda (buffer)
                        (ssh/buffer:write-uint32 buffer code)
                        (ssh/buffer:write-string* buffer "test status")
                        (ssh/buffer:write-string* buffer "en"))))

(defun file-server (stream type buffer)
  (let ((id (ssh/buffer:read-uint32 buffer)))
    (case type
      ((3 11) (reply stream 102 id (lambda (b) (ssh/buffer:write-string* b (octets 0 255)))))
      (5
       (ssh/buffer:read-string* buffer)
       (let ((offset (ssh/buffer:read-uint64 buffer)))
         (if (< offset 3)
             (reply stream 103 id (lambda (b) (ssh/buffer:write-string* b (octets (+ offset 1)))))
             (status-reply stream id 1))))
      ((7 8 17) (reply stream 105 id (lambda (b) (encode-attributes b (make-sftp-attributes :size 3)))))
      (12 (status-reply stream id 1))
      ((16 19) (reply stream 104 id (lambda (b)
                                    (ssh/buffer:write-uint32 b 1)
                                    (ssh/buffer:write-string* b (octets 47 255))
                                    (ssh/buffer:write-string* b "")
                                    (encode-attributes b nil))))
      (otherwise (status-reply stream id 0)))))

(define-test sftp-file-operations-and-short-reads :parent (:ssh/tests ssh/tests)
  (let* ((stream (make-instance 'mock-sftp-stream :callback #'file-server))
         (session (ssh/sftp::%start-session stream)))
    (unwind-protect
         (let ((handle (sftp-open-file session (octets 255) '(:read :write))))
           (is = 3 (sftp-attributes-size (sftp-fstat handle)))
           (multiple-value-bind (data eof) (sftp-read-at handle 0 3)
             (is equalp (octets 1) data) (false eof))
           (multiple-value-bind (data eof) (sftp-read-at handle 3 3)
             (is = 0 (length data)) (true eof))
           (is = 3 (sftp-write-at handle (ash 1 40) (octets 1 2 3)))
           (true (sftp-close-handle handle))
           (false (sftp-handle-open-p handle))
           (fail (sftp-read-at handle 0 1) 'sftp-error)
           (is equalp (octets 47 255) (sftp-realpath session ""))
           (false (sftp-list-directory session "")))
      (close-sftp session))))

(define-test sftp-rejects-invalid-flags-and-wrong-handle-kind :parent (:ssh/tests ssh/tests)
  (let* ((stream (make-instance 'mock-sftp-stream :callback #'file-server))
         (session (ssh/sftp::%start-session stream)))
    (unwind-protect
         (progn
           (fail (sftp-open-file session "file" '(:write :exclusive)))
           (fail (sftp-open-file session "file" '(:read :append)))
           (let ((directory (sftp-open-directory session "")))
             (fail (sftp-read-at directory 0 1) 'sftp-error)
             (true (sftp-close-handle directory)))
           (fail (sftp-posix-rename session "a" "b") 'sftp-unsupported-error))
      (close-sftp session))))

(define-test sftp-reader-matches-reordered-responses :parent (:ssh/tests ssh/tests)
  (let* ((ids nil)
         (stream (make-instance 'mock-sftp-stream
                   :callback (lambda (stream type buffer)
                               (declare (ignore type))
                               (push (ssh/buffer:read-uint32 buffer) ids)
                               (when (= 2 (length ids))
                                 (dolist (id ids) (status-reply stream id 0))))))
         (session (ssh/sftp::%start-session stream)))
    (unwind-protect
         (let ((first (ssh/sftp::%submit session 13 (lambda (b) (declare (ignore b))) 101))
               (second (ssh/sftp::%submit session 13 (lambda (b) (declare (ignore b))) 101)))
           (is = 0 (response-code (ssh/sftp::%await session first)))
           (is = 0 (response-code (ssh/sftp::%await session second)))
           (is = 0 (hash-table-count (ssh/sftp::sftp-session-pending session))))
      (close-sftp session :abort t))))

(define-test sftp-unknown-response-fails-only-its-session :parent (:ssh/tests ssh/tests)
  (let* ((stream (make-instance 'mock-sftp-stream
                   :callback (lambda (stream type buffer)
                               (declare (ignore type buffer)) (status-reply stream 999 0))))
         (session (ssh/sftp::%start-session stream)))
    (unwind-protect
         (let ((request (ssh/sftp::%submit session 13 (lambda (b) (declare (ignore b))) 101)))
           (fail (ssh/sftp::%await session request) 'sftp-protocol-error))
      (close-sftp session :abort t))))

(define-test sftp-request-id-wrap-and-retained-reply-budget :parent (:ssh/tests ssh/tests)
  (let* ((stream (make-instance 'mock-sftp-stream :callback #'file-server))
         (session (ssh/sftp::%start-session stream :max-pending 2)))
    (unwind-protect
         (progn
           (setf (ssh/sftp::sftp-session-next-id session) #xffffffff)
           (let ((a (ssh/sftp::%submit session 13 (lambda (b) (declare (ignore b))) 101))
                 (b (ssh/sftp::%submit session 13 (lambda (b) (declare (ignore b))) 101)))
             (is = #xffffffff (ssh/sftp::pending-request-id a))
             (is = 0 (ssh/sftp::pending-request-id b))
             (fail (ssh/sftp::%submit session 13 (lambda (b) (declare (ignore b))) 101) 'sftp-error)
             (ssh/sftp::%await session a) (ssh/sftp::%await session b)))
      (close-sftp session))))

(define-test sftp-empty-data-is-not-eof :parent (:ssh/tests ssh/tests)
  (let* ((stream (make-instance 'mock-sftp-stream
                   :callback (lambda (stream type buffer)
                               (if (= type 5)
                                   (reply stream 103 (ssh/buffer:read-uint32 buffer)
                                          (lambda (b) (ssh/buffer:write-string* b "")))
                                   (file-server stream type buffer)))))
         (session (ssh/sftp::%start-session stream)))
    (unwind-protect
         (let ((handle (sftp-open-file session "file" '(:read))))
           (fail (sftp-read-at handle 0 1) 'sftp-no-progress-error)
           (true (sftp-close-handle handle)))
      (close-sftp session))))

(define-test sftp-limits-and-version-gating :parent (:ssh/tests ssh/tests)
  (let ((version (ssh/buffer:make-write-buffer)) (write-sizes nil))
    (ssh/buffer:write-uint32 version 3)
    (dolist (pair '(("limits@openssh.com" . "1") ("fsync@openssh.com" . "2")))
      (ssh/buffer:write-string* version (car pair)) (ssh/buffer:write-string* version (cdr pair)))
    (let* ((stream (make-instance 'mock-sftp-stream :version-payload (ssh/buffer:buffer-to-octets version)
                     :callback
                     (lambda (stream type buffer)
                       (case type
                         (200 (reply stream 201 (ssh/buffer:read-uint32 buffer)
                                     (lambda (b) (dolist (limit '(34000 7 3 0)) (ssh/buffer:write-uint64 b limit)))))
                         (6 (let ((id (ssh/buffer:read-uint32 buffer)))
                              (ssh/buffer:read-string* buffer) (ssh/buffer:read-uint64 buffer)
                              (push (length (ssh/buffer:read-string* buffer)) write-sizes)
                              (status-reply stream id 0)))
                         (otherwise (file-server stream type buffer))))))
           (session (ssh/sftp::%start-session stream)))
      (unwind-protect
           (let ((handle (sftp-open-file session "file" '(:write))))
             (is = 3 (getf (sftp-session-limits session) :max-write-length))
             (is = 8 (sftp-write-at handle 0 (octets 1 2 3 4 5 6 7 8)))
             (is equal '(3 3 2) (nreverse write-sizes))
             (fail (sftp-fsync handle) 'sftp-unsupported-error))
        (close-sftp session)))))
