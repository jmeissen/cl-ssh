;;;; Opt-in interoperability check against a local OpenSSH sftp-server process.
(defpackage #:ssh/integration-tests/sftp
  (:use #:cl #:parachute #:trivial-gray-streams))
(in-package #:ssh/integration-tests/sftp)

(defclass stdio-stream (fundamental-binary-input-stream fundamental-binary-output-stream)
  ((input :initarg :input :reader input)
   (output :initarg :output :reader output)))
(defmethod stream-read-sequence ((stream stdio-stream) sequence start end &key &allow-other-keys)
  (read-sequence sequence (input stream) :start start :end end))
(defmethod stream-write-sequence ((stream stdio-stream) sequence start end &key &allow-other-keys)
  (write-sequence sequence (output stream) :start start :end end))
(defmethod stream-force-output ((stream stdio-stream)) (force-output (output stream)))
(defmethod close ((stream stdio-stream) &key abort)
  (declare (ignore abort))
  (when (open-stream-p stream)
    ;; Closing stdin first lets the server exit and wake its blocked stdout reader.
    (close (output stream))
    (close (input stream)))
  (call-next-method))

(define-test sftp-openssh-stdio :parent (:ssh/integration-tests ssh/integration-tests)
  (let ((server (uiop:getenv "SSH_TEST_SFTP_SERVER")))
    (if (not server)
        (skip "Set SSH_TEST_SFTP_SERVER to a local OpenSSH sftp-server executable")
        (uiop:with-temporary-file (:pathname source-path :stream source :direction :output
                                  :element-type '(unsigned-byte 8))
          (let* ((data (make-array (+ (* 4 1024 1024) 37) :element-type '(unsigned-byte 8)))
                 (root (format nil "~A.sftp-dir" (namestring source-path)))
                 (remote (concatenate 'string root "/payload-値.bin"))
                 (link (concatenate 'string root "/link"))
                 (renamed (concatenate 'string root "/renamed"))
                 (sparse (concatenate 'string root "/sparse"))
                 (process nil) (session nil) (created nil))
            (dotimes (i (length data)) (setf (aref data i) (mod i 251)))
            (write-sequence data source) (finish-output source)
            (unwind-protect
                 (progn
                   (setf process (uiop:launch-program (list server "-e") :input :stream :output :stream
                                                     :error-output :interactive :element-type '(unsigned-byte 8)))
                   (setf session (ssh/sftp::%start-session
                                  (make-instance 'stdio-stream :input (uiop:process-info-output process)
                                                              :output (uiop:process-info-input process))
                                  :symlink-order :openssh))
                   (ssh:sftp-mkdir session root :attributes (ssh:make-sftp-attributes :permissions #o700))
                   (setf created t)
                   (is = (length data)
                       (nth-value 1 (ssh:sftp-upload session source-path remote
                                                    :fsync (ssh:sftp-extension-p session "fsync@openssh.com"))))
                   (uiop:with-temporary-file (:pathname destination)
                     (is = (length data)
                         (nth-value 1 (ssh:sftp-download session remote destination :if-exists :supersede)))
                     (with-open-file (input destination :element-type '(unsigned-byte 8))
                       (let ((copy (make-array (length data) :element-type '(unsigned-byte 8))))
                         (is = (length data) (read-sequence copy input))
                         (is equalp data copy))))
                   (true (ssh:sftp-symlink session link remote))
                   (is string= remote (ssh:sftp-name-string (ssh:sftp-readlink session link)))
                   (is = #o120000 (logand #o170000 (ssh:sftp-attributes-permissions (ssh:sftp-lstat session link))))
                   (true (find (ssh/buffer:utf-8-to-octets "payload-値.bin") (ssh:sftp-list-directory session root)
                               :key #'ssh:sftp-entry-filename :test #'equalp))
                   (true (ssh:sftp-rename session remote renamed))
                   (fail (ssh:sftp-rename session renamed link) 'ssh:sftp-status-error)
                   (when (ssh:sftp-extension-p session "posix-rename@openssh.com")
                     (true (ssh:sftp-posix-rename session renamed link)))
                   (ssh:with-open-sftp-file (file session sparse :direction :io)
                     (true (file-position file (ash 1 33)))
                     (write-byte 255 file) (finish-output file)
                     (is = (1+ (ash 1 33)) (ssh:sftp-attributes-size (ssh:sftp-stat session sparse)))
                     (true (file-position file (ash 1 33)))
                     (is = 255 (read-byte file)))
                   (ssh:with-open-sftp-file (file session sparse :direction :output :if-exists :supersede)
                     (write-byte 1 file))
                   (is = 1 (ssh:sftp-attributes-size (ssh:sftp-stat session sparse))))
              (when session
                (when created
                  (dolist (path (list remote link renamed sparse)) (ignore-errors (ssh:sftp-remove session path)))
                  (ignore-errors (ssh:sftp-rmdir session root)))
                (ignore-errors (ssh:close-sftp session)))
              (when process
                (unless (uiop:process-alive-p process) (uiop:wait-process process))
                (when (uiop:process-alive-p process)
                  (uiop:terminate-process process) (uiop:wait-process process)))))))))
