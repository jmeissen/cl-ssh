(defpackage #:ssh/tests/channel-buffer
  (:use #:cl #:parachute #:ssh/channel-buffer)
  (:import-from #:ssh/tests #:octets))
(in-package #:ssh/tests/channel-buffer)

(define-test consumed-history-does-not-grow-with-transfer-size :parent (:ssh/tests ssh/tests)
  (let ((buffer (make-input-buffer))
        (chunk (make-array 32768 :element-type '(unsigned-byte 8) :initial-element 42))
        (destination (make-array 32768 :element-type '(unsigned-byte 8)))
        (peak 0))
    (dotimes (i 256)
      (buffer-accept buffer chunk)
      (setf peak (max peak (input-buffer-count buffer)))
      (buffer-take buffer destination 0 (length destination)))
    (is = 32768 peak)
    (is = 0 (input-buffer-count buffer))
    (false (ssh/channel-buffer::input-buffer-head buffer))
    (false (ssh/channel-buffer::input-buffer-tail buffer))
    (false (typep buffer 'ssh/channel-buffer::capture-buffer))))

(define-test stream-buffer-reclaims-consumed-chunks :parent (:ssh/tests ssh/tests)
  (let ((buffer (make-input-buffer)) (out (octets 0 0 0)))
    (is = 0 (buffer-accept buffer (octets 1 2)))
    (buffer-accept buffer (octets 3 4))
    (is equal '(3 3) (multiple-value-list (buffer-take buffer out 0 3)))
    (is equalp (octets 1 2 3) out)
    (is equalp (octets 4) (buffer-snapshot buffer))
    (buffer-take buffer out 0 3)
    (is = 0 (input-buffer-count buffer))
    (false (ssh/channel-buffer::input-buffer-head buffer))))

(define-test capture-is-explicit-and-keeps-history :parent (:ssh/tests ssh/tests)
  (let ((buffer (make-input-buffer :mode :capture)) (out (octets 0 0)))
    (is = 3 (buffer-accept buffer (octets 1 2 3)))
    (is equal '(2 0) (multiple-value-list (buffer-take buffer out 0 2)))
    (is equalp (octets 1 2 3) (buffer-snapshot buffer))
    (is = 1 (input-buffer-count buffer))))

(define-test diagnostic-tail-is-bounded :parent (:ssh/tests ssh/tests)
  (let ((buffer (make-input-buffer :mode :tail :limit 3)))
    (is = 5 (buffer-accept buffer (octets 1 2 3 4 5)))
    (is equalp (octets 3 4 5) (buffer-snapshot buffer))
    (true (input-buffer-truncated-p buffer))
    (buffer-accept buffer (octets 6))
    (is equalp (octets 4 5 6) (buffer-snapshot buffer))))
