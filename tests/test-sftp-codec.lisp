(defpackage #:ssh/tests/sftp-codec
  (:use #:cl #:parachute #:ssh/sftp/codec)
  (:import-from #:ssh/tests #:octets))
(in-package #:ssh/tests/sftp-codec)

(define-test sftp-rejects-oversize-and-truncated-frames :parent (:ssh/tests ssh/tests)
  (dolist (data (list (octets 255 255 255 255) (octets 0 0 0 0)
                     (octets 0 0 0 5 2 0) (octets 0 0)))
    (ironclad:with-octet-input-stream (stream data)
      (fail (read-frame stream) 'sftp-protocol-error))))

(define-test sftp-frame-length-includes-type :parent (:ssh/tests ssh/tests)
  (is equalp (octets 0 0 0 5 1 0 0 0 3) (encode-frame 1 (octets 0 0 0 3))))

(define-test sftp-attributes-preserve-zero-and-absence :parent (:ssh/tests ssh/tests)
  (let ((buffer (ssh/buffer:make-write-buffer)))
    (encode-attributes buffer (make-sftp-attributes :size 0 :uid 0 :gid 9 :atime 0 :mtime 3))
    (let ((attrs (decode-attributes (ssh/buffer:make-read-buffer (ssh/buffer:buffer-to-octets buffer)))))
      (is = 0 (sftp-attributes-size attrs))
      (is = 0 (sftp-attributes-uid attrs))
      (false (sftp-attributes-permissions attrs))
      (is = 3 (sftp-attributes-mtime attrs)))))

(define-test sftp-attribute-pairs-and-unknown-flags :parent (:ssh/tests ssh/tests)
  (fail (encode-attributes (ssh/buffer:make-write-buffer) (make-sftp-attributes :uid 0)))
  (fail (encode-attributes (ssh/buffer:make-write-buffer) (make-sftp-attributes :mtime 1)))
  (fail (decode-attributes (ssh/buffer:make-read-buffer (octets 0 0 0 16))) 'sftp-protocol-error))

(define-test sftp-version-keeps-unknown-and-repeated-extensions :parent (:ssh/tests ssh/tests)
  (let ((buffer (ssh/buffer:make-write-buffer)))
    (ssh/buffer:write-uint32 buffer 3)
    (dotimes (i 2)
      (ssh/buffer:write-string* buffer "unknown@example.org")
      (ssh/buffer:write-string* buffer (if (zerop i) "" "2")))
    (multiple-value-bind (version extensions) (decode-version (ssh/buffer:buffer-to-octets buffer))
      (is = 3 version) (is = 2 (length extensions)))))

(define-test sftp-handles-and-name-counts-are-bounded :parent (:ssh/tests ssh/tests)
  (let ((buffer (ssh/buffer:make-write-buffer)))
    (ssh/buffer:write-uint32 buffer 1)
    (ssh/buffer:write-string* buffer (make-array 257 :element-type '(unsigned-byte 8) :initial-element 0))
    (fail (decode-response 102 (ssh/buffer:buffer-to-octets buffer)) 'sftp-protocol-error))
  (fail (decode-response 104 (octets 0 0 0 1 255 255 255 255)) 'sftp-protocol-error)
  (fail (decode-response 105 (octets 0 0 0 1 0 0 0 0 9)) 'sftp-protocol-error))

(define-test sftp-paths-preserve-binary-names :parent (:ssh/tests ssh/tests)
  (is equalp (octets 255 47 0) (path-octets (octets 255 47 0)))
  (is = 0 (length (path-octets "")))
  (is string= "値" (sftp-name-string (path-octets "値"))))
